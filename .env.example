# Local secrets for docker compose. Don't copy this file by hand: run
#   .\scripts\init-env.ps1
# which writes .env (git-ignored) with a fresh random value for each of these.
#
# LOCAL DEVELOPMENT ONLY. Never reuse these anywhere real.

POSTGRES_SUPERUSER_PASSWORD=
# Flyway migrations log in as helpdesk_owner; the running API as helpdesk_app.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
RABBITMQ_PASSWORD=
# The API's client secret in Keycloak (imported into the realm on Keycloak's first start)
KEYCLOAK_CLIENT_SECRET=
# Password of the demo users ada, sam, ann and ben (imported on Keycloak's first start)
DEMO_USER_PASSWORD=
